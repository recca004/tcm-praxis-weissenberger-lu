---
// Brand icon links — renders only networks whose URL is confirmed in site.js.
// (Lucide does not ship brand logos, so these are inline SVG paths.)
import { SOCIAL } from '../data/site.js';

const ICONS = {
  instagram: {
    label: 'Instagram',
    svg: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/>',
  },
  facebook: {
    label: 'Facebook',
    svg: '<path fill="currentColor" d="M13.5 21v-7.8h2.6l.4-3h-3V8.3c0-.87.24-1.47 1.5-1.47h1.6V4.1c-.28-.04-1.24-.12-2.35-.12-2.33 0-3.93 1.42-3.93 4.03v2.19H7.6v3h2.66V21h3.24z"/>',
  },
  linkedin: {
    label: 'LinkedIn',
    svg: '<path fill="currentColor" d="M6.5 8.8H3.6V21h2.9V8.8zM5 7.4a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4zM20.4 14.1c0-3.2-1.7-4.7-4-4.7-1.85 0-2.67 1.02-3.13 1.74V8.8h-2.9V21h2.9v-6.3c0-1.57.74-2.43 1.98-2.43 1.1 0 1.72.75 1.72 2.43V21h3.43v-6.9z"/>',
  },
  whatsapp: {
    label: 'WhatsApp',
    svg: '<path fill="currentColor" d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.58-.35M12.04 21.79h-.01a9.75 9.75 0 0 1-4.97-1.36l-.36-.21-3.69.97.98-3.6-.23-.37a9.73 9.73 0 0 1-1.5-5.2c0-5.38 4.39-9.76 9.78-9.76a9.7 9.7 0 0 1 6.91 2.86 9.7 9.7 0 0 1 2.86 6.9c0 5.39-4.38 9.77-9.77 9.77M20.44 3.54A11.7 11.7 0 0 0 12.04 0C5.46 0 .1 5.35.1 11.92c0 2.1.55 4.15 1.59 5.96L0 24l6.28-1.65a11.9 11.9 0 0 0 5.76 1.47h.01c6.58 0 11.94-5.35 11.94-11.92 0-3.19-1.24-6.18-3.55-8.36"/>',
  },
};

const links = Object.entries(ICONS)
  .filter(([key]) => SOCIAL[key])
  .map(([key, icon]) => ({ url: SOCIAL[key], ...icon }));
---
{links.length > 0 && (
  <ul class="footer-social">
    {links.map(({ url, label, svg }) => (
      <li>
        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={label}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" set:html={svg} />
        </a>
      </li>
    ))}
  </ul>
)}
