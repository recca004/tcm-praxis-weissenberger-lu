---
// All non-home pages share this shell: back link + header + page body.
import BackLink from '../BackLink.astro';
import SectionHeader from '../SectionHeader.astro';
import TreatmentIndex from '../sections/TreatmentIndex.astro';
import PractitionerEditorial from '../sections/PractitionerEditorial.astro';
import StepsTimeline from '../sections/StepsTimeline.astro';
import PriceTable from '../sections/PriceTable.astro';
import InfoBlocks from '../sections/InfoBlocks.astro';
import BookingWidget from '../sections/BookingWidget.astro';
import ContactDetails from '../sections/ContactDetails.astro';
import TransitCard from '../sections/TransitCard.astro';
import ContactForm from '../sections/ContactForm.astro';
import ContactMap from '../sections/ContactMap.astro';
import CTABanner from '../sections/CTABanner.astro';
import LegalPage from '../sections/LegalPage.astro';
import Icon from '../Icon.astro';
import Rev from '../Rev.astro';
import { TREATMENTS_PAGE, DIAGNOSTIC } from '../../data/treatments.js';
import { SYMPTOMS_PAGE } from '../../data/symptoms.js';
import { ABOUT_PAGE } from '../../data/practitioner.js';
import { FIRST_VISIT_PAGE } from '../../data/firstVisit.js';
import { PRICES_PAGE } from '../../data/prices.js';
import { BOOKING } from '../../data/booking.js';
import { CONTACT_PAGE, MAP_SECTION } from '../../data/contact.js';
import { PRACTICE } from '../../data/site.js';
import { ROUTES } from '../../data/routes.js';

const { locale, pageId } = Astro.props;
const HEADER = {
  treatments: { d: TREATMENTS_PAGE, center: false },
  symptoms: { d: SYMPTOMS_PAGE, center: false },
  about: { d: ABOUT_PAGE, center: false },
  firstVisit: { d: FIRST_VISIT_PAGE, center: false },
  prices: { d: PRICES_PAGE, center: false },
  booking: { d: { eyebrow: BOOKING.page.sectionEyebrow, title: BOOKING.page.sectionTitle, lead: BOOKING.page.sectionLead }, center: true },
  contact: { d: CONTACT_PAGE, center: false },
}[pageId];
const isLegal = pageId === 'privacy' || pageId === 'imprint';
---
{isLegal ? (
  <LegalPage locale={locale} doc={pageId} />
) : (
  <div class="container page-top">
    <BackLink locale={locale} />
    {pageId === 'firstVisit' ? (
      <div class="grid-2" style="align-items: center; margin-bottom: var(--space-16);">
        <SectionHeader eyebrow={HEADER.d.eyebrow[locale]} title={HEADER.d.title[locale]} lead={HEADER.d.lead?.[locale]} level="h1" rev={HEADER.d.rev?.[locale] || []} />
        <img src="/assets/images/clinic-waiting-area.webp" width="1500" height="987" alt={{de:'Wartebereich der Praxis mit zwei Sesseln',en:'Practice waiting area with two chairs',zh:'诊所候诊区 — 两把座椅'}[locale]} loading="eager" style="width:100%;aspect-ratio:4/3;object-fit:cover;display:block;border-radius:var(--radius-lg);border:1px solid var(--color-border);" />
      </div>
    ) : pageId === 'about' ? null : (
      <SectionHeader eyebrow={HEADER.d.eyebrow[locale]} title={HEADER.d.title[locale]} lead={HEADER.d.lead?.[locale]} level="h1" center={HEADER.center} rev={HEADER.d.rev?.[locale] || []} />
    )}

    {pageId === 'treatments' && (
      <>
        <TreatmentIndex locale={locale} variant="page" />
        <div class="diagnostic-open">
          <div>
            <h2>{DIAGNOSTIC.title[locale]}</h2>
            <Rev when={(DIAGNOSTIC.rev?.[locale] || []).includes('lead')} />
            <p>{DIAGNOSTIC.lead[locale]}</p>
            <ul style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
              {DIAGNOSTIC.items.map((item) => (
                <li style="display: flex; gap: 0.5rem; align-items: flex-start; font-size: var(--text-sm);">
                  <Icon name="check-circle-2" size={18} class="check-icon" />
                  <span set:html={item[locale]} />
                </li>
              ))}
            </ul>
          </div>
          <img src={DIAGNOSTIC.image[locale].src} width="1500" height="1000" alt={DIAGNOSTIC.image[locale].alt} loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius: var(--radius-lg); border: 1px solid var(--color-border);" />
        </div>
        <CTABanner locale={locale} pageId="treatments" />
      </>
    )}

    {pageId === 'symptoms' && (
      <>
        <h2 class="sr-only">{{de:'Die vier häufigsten Anliegen',en:'The four most common concerns',zh:'四类最常见健康问题'}[locale]}</h2>
        <div class="pillars-ed" style="margin-bottom: var(--space-10);">
          {SYMPTOMS_PAGE.concerns.map((c, i) => (
            <div class="pillar-row">
              <span class="pillar-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="pillar-icon"><Icon name={c.icon} /></div>
              <div class="pillar-body">
                <h3>{c.title[locale]}</h3>
                <Rev when={c.rev?.[locale]} />
                <p>{c.desc[locale]}</p>
                <p class="pillar-approach"><strong>{SYMPTOMS_PAGE.approachLabel[locale]}</strong> {c.approach[locale]}</p>
                <a href={ROUTES.booking[locale]} class="card-action-link" style="margin-top: var(--space-3);">
                  {SYMPTOMS_PAGE.consultLink[locale]} <Icon name="arrow-up-right" size={15} />
                </a>
              </div>
            </div>
          ))}
        </div>
        <div class="sym-extra">
          <h2 class="sym-extra-title">{SYMPTOMS_PAGE.extra.heading[locale]} <Rev when={true} /></h2>
          <div class="sym-extra-grid">
            {SYMPTOMS_PAGE.extra.groups.map((g) => (
              <div class="sym-extra-group">
                <h3><Icon name={g.icon} size={18} /> {g.title[locale]}</h3>
                <ul>
                  {g.items[locale].map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <div class="sym-extra-footer">
            <p class="sym-extra-note">{SYMPTOMS_PAGE.extra.note[locale]}</p>
            <p class="sym-extra-src">
              {SYMPTOMS_PAGE.extra.sourceLabel[locale]}:
              {' '}<a href="https://www.helsana.ch/fr/prives/savoir/medecine-complementaire/acupuncture.html" target="_blank" rel="noopener noreferrer">Helsana</a>
              {' · '}<a href="https://www.nccih.nih.gov/health/acupuncture-effectiveness-and-safety" target="_blank" rel="noopener noreferrer">NCCIH</a>
            </p>
          </div>
        </div>
        <div style="margin-bottom: var(--space-12); text-align: center;">
          <p style="color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--space-2);">{SYMPTOMS_PAGE.methods.text[locale]}</p>
          <a href={ROUTES.treatments[locale]} class="card-action-link">{SYMPTOMS_PAGE.methods.link[locale]} <Icon name="arrow-up-right" size={15} /></a>
        </div>
        <CTABanner locale={locale} pageId="symptoms" />
      </>
    )}

    {pageId === 'about' && (
      <>
        <PractitionerEditorial locale={locale} variant="about" />
        <h2 class="sr-only">{{de:'Behandlungsansatz & Praxiswerte',en:'Treatment approach & practice values',zh:'诊疗理念与实践价值'}[locale]}</h2>
        <div class="pillars-ed" style="margin-bottom: var(--space-16);">
          {ABOUT_PAGE.pillars.map((p, i) => (
            <div class="pillar-row">
              <span class="pillar-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="pillar-icon"><Icon name={p.icon} /></div>
              <div class="pillar-body">
                <Rev when={p.rev?.[locale]} />
                <h3>{p.title[locale]}</h3>
                <p>{p.desc[locale]}</p>
              </div>
            </div>
          ))}
        </div>
        <CTABanner locale={locale} pageId="about" />
      </>
    )}

    {pageId === 'firstVisit' && (
      <>
        <StepsTimeline steps={FIRST_VISIT_PAGE.steps} locale={locale} titleTag="h2" pageStyle editorial />
        <div style="margin-bottom: var(--space-16);">
          <InfoBlocks blocks={FIRST_VISIT_PAGE.boxes} locale={locale} />
        </div>
        <CTABanner locale={locale} pageId="firstVisit" />
      </>
    )}

    {pageId === 'prices' && (
      <div class="prices-page">
        <PriceTable locale={locale} head={PRICES_PAGE.tableHead[locale]} rows={PRICES_PAGE.rows} showBilling billingBadge={PRICES_PAGE.billingBadge} open />
        <div style="margin-bottom: var(--space-16);">
          <InfoBlocks blocks={PRICES_PAGE.cards} locale={locale} />
        </div>
        <CTABanner locale={locale} pageId="prices" />
      </div>
    )}

    {pageId === 'booking' && (
      <>
        <BookingWidget locale={locale} variant="page" />
        <div class="ed-panel" style="max-width: 680px; margin: 0 auto var(--space-16); text-align: center;">
          <h3 style="margin-bottom: 0.5rem;">{BOOKING.shared.phoneAlt.title[locale]}</h3>
          <p style="font-size: var(--text-sm); color: var(--color-muted); margin-bottom: 1.25rem;">
            {BOOKING.shared.phoneAlt.text[locale]}
          </p>
          <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
            <a href={PRACTICE.landlineHref} class="btn btn-secondary">
              <Icon name="phone" size={18} /> {BOOKING.shared.phoneAlt.landlineBtn[locale]}
            </a>
            <a href={PRACTICE.phoneHref} class="btn btn-secondary">
              <Icon name="phone" size={18} /> {BOOKING.shared.phoneAlt.btn[locale]}
            </a>
          </div>
        </div>
      </>
    )}

    {pageId === 'contact' && (
      <>
        <div class="contact-cols">
          <div>
            <h2 style="margin-bottom: var(--space-2);">{CONTACT_PAGE.cardTitle[locale]}</h2>
            <ContactDetails locale={locale} variant="page" mapsLabel={CONTACT_PAGE.mapsBtn[locale]} />
            <TransitCard locale={locale} />
          </div>
          <ContactForm locale={locale} variant="page" />
        </div>
        <h2 style="margin-bottom: var(--space-6);">{MAP_SECTION.title[locale]}</h2>
        <ContactMap locale={locale} />
      </>
    )}
  </div>
)}
