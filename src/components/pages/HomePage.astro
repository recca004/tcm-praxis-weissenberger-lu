---
import Hero from '../sections/Hero.astro';
import SectionHeader from '../SectionHeader.astro';
import TreatmentIndex from '../sections/TreatmentIndex.astro';
import StatementMoment from '../sections/StatementMoment.astro';
import PractitionerEditorial from '../sections/PractitionerEditorial.astro';
import StepsTimeline from '../sections/StepsTimeline.astro';
import PriceBlocks from '../sections/PriceBlocks.astro';
import InsuranceCard from '../sections/InsuranceCard.astro';
import FaqAccordion from '../sections/FaqAccordion.astro';
import BookingBand from '../sections/BookingBand.astro';
import ContactDetails from '../sections/ContactDetails.astro';
import ContactForm from '../sections/ContactForm.astro';
import CTABanner from '../sections/CTABanner.astro';
import InsuranceLogoCarousel from '../sections/InsuranceLogoCarousel.astro';
import Icon from '../Icon.astro';
import Rev from '../Rev.astro';
import { TREATMENTS_SECTION } from '../../data/treatments.js';
import { FIRST_VISIT_HOME } from '../../data/firstVisit.js';
import { PRICES_HOME } from '../../data/prices.js';
import { FAQ_SECTION } from '../../data/faq.js';
import { CONTACT_HOME } from '../../data/contact.js';
import { HERO, HOME_CONCERNS } from '../../data/home.js';
import { INSURANCE_SECTION } from '../../data/insurers.js';
import { ROUTES } from '../../data/routes.js';

const { locale } = Astro.props;
const anchors = { de: { treatments: 'behandlungen', booking: 'online-termin', contact: 'kontakt' }, en: { treatments: 'treatments', booking: 'booking', contact: 'contact' }, zh: { treatments: 'liaofa', booking: 'yuyue', contact: 'lianxi' } }[locale];
---
<Hero locale={locale} />

<StatementMoment locale={locale} />

<section class="section section-treatments" id={anchors.treatments}>
  <div class="container">
    <SectionHeader title={TREATMENTS_SECTION.title[locale]} lead={TREATMENTS_SECTION.lead[locale]} rev={TREATMENTS_SECTION.rev?.[locale] || []} />
    <TreatmentIndex locale={locale} limit={5} />
    <div style="margin-top: 2.5rem;">
      <a href={ROUTES.treatments[locale]} class="btn btn-secondary">{HERO.secondary[locale]} <Icon name="arrow-up-right" size={16} /></a>
    </div>
    <div class="home-concerns" style="margin-top: var(--space-10); border-top: 1px solid var(--color-border); padding-top: var(--space-8);">
      <p style="max-width: 68ch; color: var(--color-muted); font-size: var(--text-base); margin-bottom: var(--space-3);">{HOME_CONCERNS.text[locale]}</p>
      <a href={ROUTES.symptoms[locale]} class="card-action-link">{HOME_CONCERNS.link[locale]} <Icon name="arrow-up-right" size={15} /></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <PractitionerEditorial locale={locale} />
  </div>
</section>

<section class="section section-subtle">
  <div class="container">
    <SectionHeader title={FIRST_VISIT_HOME.title[locale]} lead={FIRST_VISIT_HOME.lead[locale]} />
    <StepsTimeline steps={FIRST_VISIT_HOME.steps} locale={locale} editorial />
    <div style="margin-top: 2.5rem; text-align: center;">
      <a href={ROUTES.firstVisit[locale]} class="btn btn-secondary">{FIRST_VISIT_HOME.link[locale]}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid-2-asym">
      <div>
        <h2>{PRICES_HOME.title[locale]}</h2>
        <Rev when={(PRICES_HOME.rev?.[locale] || []).includes('text')} />
        <p>{PRICES_HOME.text[locale]}</p>
        <PriceBlocks locale={locale} compact />
        <a href={ROUTES.prices[locale]} class="card-action-link">{PRICES_HOME.link[locale]} <Icon name="arrow-up-right" size={15} /></a>
      </div>
      <div>
        <InsuranceCard locale={locale} />
      </div>
    </div>
    <div style="margin-top: var(--space-12); border-top: 1px solid var(--color-border); padding-top: var(--space-10);">
      <h3 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">{INSURANCE_SECTION.title[locale]}</h3>
      <p style="max-width: 62ch; color: var(--color-muted); font-size: var(--text-base); margin-bottom: var(--space-4);">{INSURANCE_SECTION.text[locale]}</p>
      <a href={ROUTES.prices[locale]} class="card-action-link">{INSURANCE_SECTION.link[locale]} <Icon name="arrow-up-right" size={15} /></a>
    </div>
    <InsuranceLogoCarousel locale={locale} />
  </div>
</section>

<section class="section section-subtle">
  <div class="container container-narrow">
    <SectionHeader title={FAQ_SECTION.title[locale]} lead={FAQ_SECTION.lead[locale]} center />
    <FaqAccordion locale={locale} />
  </div>
</section>

<section class="section" id={anchors.booking}>
  <div class="container">
    <BookingBand locale={locale} />
  </div>
</section>

<section class="section section-subtle" id={anchors.contact}>
  <div class="container">
    <div class="grid-2">
      <div>
        <h2>{CONTACT_HOME.title[locale]}</h2>
        <p>{CONTACT_HOME.text[locale]}</p>
        <ContactDetails locale={locale} variant="home" mapsLabel={CONTACT_HOME.mapsBtn[locale]} />
      </div>
      <div>
        <ContactForm locale={locale} variant="home" />
      </div>
    </div>
  </div>
</section>

<CTABanner locale={locale} pageId="home" inSection />
