---
// Floating WhatsApp contact button — fixed bottom-right, opens wa.me chat.
import { SOCIAL } from '../data/site.js';
const { locale } = Astro.props;
const label = { de: 'Per WhatsApp kontaktieren', en: 'Contact us on WhatsApp' }[locale] || 'WhatsApp';
---
{SOCIAL.whatsapp && (
  <a
    href={SOCIAL.whatsapp}
    class="wa-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={label}
    title={label}
  >
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.58-.35M12.04 21.79h-.01a9.75 9.75 0 0 1-4.97-1.36l-.36-.21-3.69.97.98-3.6-.23-.37a9.73 9.73 0 0 1-1.5-5.2c0-5.38 4.39-9.76 9.78-9.76a9.7 9.7 0 0 1 6.91 2.86 9.7 9.7 0 0 1 2.86 6.9c0 5.39-4.38 9.77-9.77 9.77M20.44 3.54A11.7 11.7 0 0 0 12.04 0C5.46 0 .1 5.35.1 11.92c0 2.1.55 4.15 1.59 5.96L0 24l6.28-1.65a11.9 11.9 0 0 0 5.76 1.47h.01c6.58 0 11.94-5.35 11.94-11.92 0-3.19-1.24-6.18-3.55-8.36"/>
    </svg>
    <span class="wa-float-label">{label}</span>
  </a>
)}
