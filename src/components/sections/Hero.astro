---
import { ROUTES } from '../../data/routes.js';
import { HERO, TRUST_ITEMS, HERO_SLIDES } from '../../data/home.js';
import HeroSlideshow from './HeroSlideshow.astro';
const { locale } = Astro.props;
const D = HERO;
---
<section class="section section-hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <span class="eyebrow">{D.eyebrow[locale]}</span>
        <h1 class="hero-title">{D.title[locale]}</h1>
        <p class="lead">{D.lead[locale]}</p>
        <div class="hero-actions">
          <a href={ROUTES.booking[locale]} class="btn btn-primary btn-lg">{D.primary[locale]}</a>
          <a href={ROUTES.treatments[locale]} class="btn btn-secondary btn-lg">{D.secondary[locale]}</a>
        </div>
        <dl class="hero-facts">
          {TRUST_ITEMS.map((t) => (
            <div class="hero-fact">
              <dt>{typeof t.h === 'string' ? t.h : t.h[locale]} {t.badge && <span class="badge-confirm">{t.badge[locale]}</span>}</dt>
              <dd>{t.p[locale]}</dd>
            </div>
          ))}
        </dl>
      </div>
      <figure class="hero-media-wrapper">
        <div class="hero-image-frame">
          <HeroSlideshow locale={locale} slides={HERO_SLIDES} />
        </div>
      </figure>
    </div>
  </div>
</section>
