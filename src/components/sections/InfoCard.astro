---
import Icon from '../Icon.astro';
const { icon, title, textHtml, itemsHtml, locale } = Astro.props;
---
<div style="background: var(--color-surface); padding: var(--space-8); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
  <div class="trust-icon-box" style="margin-bottom: 1rem;"><Icon name={icon} /></div>
  <h2 style="font-size: var(--text-xl); margin-bottom: 1rem;">{title[locale]}</h2>
  {textHtml && <p style="font-size: var(--text-sm); color: var(--color-muted); line-height: 1.6;" set:html={textHtml[locale]} />}
  <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
    {itemsHtml.map((item) => (
      <div style="display: flex; gap: 0.5rem; font-size: var(--text-sm);">
        <Icon name="check" size={18} class="check-icon" />
        <span set:html={item[locale]} />
      </div>
    ))}
  </div>
</div>
