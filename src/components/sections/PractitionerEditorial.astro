---
// Editorial practitioner section (home) — honest labeled portrait slot,
// serif quote weight, quiet credential list.
import Icon from '../Icon.astro';
import Rev from '../Rev.astro';
import { PORTRAIT, CREDENTIALS, PRACTITIONER_HOME } from '../../data/practitioner.js';
import { ROUTES } from '../../data/routes.js';

const { locale } = Astro.props;
const D = PRACTITIONER_HOME;
---
<div class="pract-ed">
  <div class="pract-ed-photo">
    <div class="portrait-silhouette" aria-hidden="true"><Icon name="user" size={56} /></div>
    <div class="portrait-label">{PORTRAIT.name}</div>
    <div class="portrait-sublabel">{PORTRAIT.sublabel[locale]}</div>
    <span class="badge badge-confirm" style="margin-top: 10px;">{PORTRAIT.badge[locale]}</span>
  </div>
  <div class="pract-ed-body">
    <span class="eyebrow">{D.eyebrow[locale]}</span>
    <h2 class="pract-ed-name">{D.title[locale]}</h2>
    {D.paragraphs.map((p) => (
      <>
        <Rev when={p.rev?.[locale]} />
        <p>{p[locale]}</p>
      </>
    ))}
    <ul class="pract-ed-creds">
      {CREDENTIALS.map((c) => (
        <li><Icon name={c.icon} size={18} /><span>{c[locale]}</span> <span class="badge badge-confirm">[CONFIRM]</span></li>
      ))}
    </ul>
    <div class="practitioner-languages">
      <Icon name="languages" />
      <span set:html={D.languagesHtml[locale]} />
    </div>
    <div class="pract-ed-actions">
      <a href={ROUTES.about[locale]} class="btn btn-secondary">{D.moreBtn[locale]}</a>
      <a href={ROUTES.booking[locale]} class="btn btn-primary">{D.bookBtn[locale]}</a>
    </div>
  </div>
</div>
