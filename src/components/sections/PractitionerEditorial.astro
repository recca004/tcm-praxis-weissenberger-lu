---
// Editorial practitioner section — honest labeled portrait slot,
// serif headline, quiet credential list.
// variant="home" (homepage) | variant="about" (About Min page body)
import Icon from '../Icon.astro';
import Rev from '../Rev.astro';
import { PORTRAIT, CREDENTIALS, CREDENTIALS_ABOUT, PRACTITIONER_HOME, ABOUT_PAGE } from '../../data/practitioner.js';
import { ROUTES } from '../../data/routes.js';

const { locale, variant = 'home' } = Astro.props;
const isAbout = variant === 'about';
const D = isAbout ? ABOUT_PAGE : PRACTITIONER_HOME;
const creds = isAbout ? CREDENTIALS_ABOUT : CREDENTIALS;
---
<div class:list={['pract-ed', { 'pract-ed--about': isAbout }]}>
  <div class="pract-ed-photo pract-ed-photo--real">
    <img src="/assets/images/practitioner-portrait.webp" width="1417" height="945" alt={PORTRAIT.alt[locale]} loading="lazy" />
  </div>
  <div class="pract-ed-body">
    {!isAbout && <span class="eyebrow">{D.eyebrow[locale]}</span>}
    {isAbout ? (
      <h1 class="pract-ed-name">{D.title[locale]}</h1>
    ) : (
      <h2 class="pract-ed-name">{D.title[locale]}</h2>
    )}
    {D.paragraphs.map((p) => (
      <>
        <Rev when={p.rev?.[locale]} />
        <p>{p[locale]}</p>
      </>
    ))}
    {isAbout && (
      <>
        <ul class="pract-ed-creds">
          {creds.map((c) => (
            <li><Icon name={c.icon} size={18} /><span>{c[locale]}</span> {!c.confirmed && <span class="badge badge-confirm">[CONFIRM]</span>}</li>
          ))}
        </ul>
        <div class="practitioner-languages">
          <Icon name="languages" />
          <span set:html={D.languagesHtml[locale]} />
        </div>
        <a href="https://emr.ch/de/therapeut/min.weissenberger-lu" target="_blank" rel="noopener noreferrer" class="card-action-link" style="margin-top: var(--space-3); display: inline-flex; align-items: center; gap: 0.35rem;">
          {({de:'Offizielles EMR-Profil',en:'Official EMR profile',zh:'EMR 官方执业档案'})[locale]} <Icon name="external-link" size={15} />
        </a>
      </>
    )}
    {!isAbout && (
      <div class="pract-ed-actions">
        <a href={ROUTES.about[locale]} class="btn btn-secondary">{D.moreBtn[locale]}</a>
        <a href={ROUTES.booking[locale]} class="btn btn-primary">{D.bookBtn[locale]}</a>
      </div>
    )}
  </div>
</div>
