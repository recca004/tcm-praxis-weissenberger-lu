---
import Icon from '../Icon.astro';
import BackLink from '../BackLink.astro';
import { LEGAL } from '../../data/legal.js';
const { locale, doc } = Astro.props;
const D = LEGAL[doc];
---
<div class="container container-narrow page-top">
  <BackLink locale={locale} />

  <div class="notice-box">
    <Icon name="alert-triangle" size={18} style="display: inline; vertical-align: middle; margin-right: 4px;" />
    <span set:html={D.noticeHtml[locale]} />
  </div>

  <span class="eyebrow">{D.eyebrow[locale]}</span>
  <h1>{D.title[locale]}</h1>
  <p class="lead">{D.lead[locale]}</p>

  <div class="ed-legal">
    {D.sections.map((s, i) => (
      <section class="ed-legal-section">
        <h2>{s.h[locale]}</h2>
        <p set:html={s.html[locale]} />
      </section>
    ))}
  </div>
</div>
