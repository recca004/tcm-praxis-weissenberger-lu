---
import Icon from '../Icon.astro';
import { TRANSIT } from '../../data/contact.js';
const { locale } = Astro.props;
---
<div style="background: var(--color-surface); padding: var(--space-8); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-subtle);">
  <h3 style="margin-bottom: 1rem;">{TRANSIT.title[locale]}</h3>
  <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: var(--text-sm); color: var(--color-muted);">
    {TRANSIT.items.map((item) => (
      <div style="display: flex; gap: 0.5rem; align-items: flex-start;">
        <Icon name={item.icon} size={18} class="check-icon" />
        <span set:html={item.html[locale]} />
      </div>
    ))}
  </div>
</div>
