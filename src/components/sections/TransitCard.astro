---
// Public transport & parking — inline list inside the Practice Details
// column (no card). Items flagged `pending` stay hidden until confirmed.
import Icon from '../Icon.astro';
import { TRANSIT } from '../../data/contact.js';
const { locale } = Astro.props;
const items = TRANSIT.items.filter((item) => !item.pending);
---
<div class="contact-transit">
  <h3 class="contact-transit-title">{TRANSIT.title[locale]}</h3>
  <ul class="contact-transit-list">
    {items.map((item) => (
      <li>
        <Icon name={item.icon} size={18} />
        <span set:html={item.html[locale]} />
      </li>
    ))}
  </ul>
</div>
