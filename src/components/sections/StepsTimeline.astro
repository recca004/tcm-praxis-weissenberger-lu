---
import Rev from '../Rev.astro';
const { steps, locale, titleTag = 'h3', pageStyle = false, editorial = false } = Astro.props;
const Tag = titleTag;
---
<div class:list={['timeline-grid', { 'steps-editorial': editorial, 'timeline-grid-4col': steps.length > 3 }]} {...(pageStyle ? { style: 'margin-bottom: var(--space-12);' } : {})}>
  {steps.map((s, i) => (
    <div class="timeline-step">
      <div class="step-number">{i + 1}</div>
      <Rev when={s.rev?.[locale] && s.revTitle !== false} />
      {pageStyle
        ? <Tag class="step-title" style="font-size: var(--text-lg);">{s.title[locale]}</Tag>
        : <Tag class="step-title">{s.title[locale]}</Tag>}
      <Rev when={s.rev?.[locale]} />
      <p class="step-desc">{s.desc[locale]}</p>
      {s.badge && <span class="badge badge-confirm step-badge">{s.badge[locale]}</span>}
    </div>
  ))}
</div>
