---
import Icon from '../Icon.astro';
import { CTA } from '../../data/cta.js';
import { ROUTES } from '../../data/routes.js';
import { PRACTICE } from '../../data/site.js';
const { locale, pageId, inSection = false } = Astro.props;
const D = CTA[pageId];
const secondaryHref = D.secondary === 'phone' ? PRACTICE.phoneHref : ROUTES.contact[locale];
const SecondaryIcon = D.secondary === 'phone';
---
{inSection ? (
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="cta-banner">
        <h2>{D.title[locale]}</h2>
        <p>{D.text[locale]}</p>
        <div class="cta-banner-buttons">
          <a href={ROUTES.booking[locale]} class="btn btn-secondary btn-lg">{D.primary[locale]}</a>
          <a href={secondaryHref} class="cta-phone-fallback">
            {SecondaryIcon && <Icon name="phone" size={18} />} {D.secondaryLabel[locale]}
          </a>
        </div>
      </div>
    </div>
  </section>
) : (
  <div class="cta-banner" style="margin-bottom: var(--space-16);">
    <h2>{D.title[locale]}</h2>
    <p>{D.text[locale]}</p>
    <div class="cta-banner-buttons">
      <a href={ROUTES.booking[locale]} class="btn btn-secondary btn-lg">{D.primary[locale]}</a>
      <a href={secondaryHref} class="cta-phone-fallback">
        {SecondaryIcon && <Icon name="phone" size={18} />} {D.secondaryLabel[locale]}
      </a>
    </div>
  </div>
)}
