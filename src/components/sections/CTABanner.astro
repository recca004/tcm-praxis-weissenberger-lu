---
import Icon from '../Icon.astro';
import { CTA } from '../../data/cta.js';
import { ROUTES } from '../../data/routes.js';
import { PRACTICE } from '../../data/site.js';
const { locale, pageId, inSection = false } = Astro.props;
const D = CTA[pageId];
// Primary action: 'landline' renders the confirmed landline number;
// anything else is a label object leading to the booking page.
const primaryIsLandline = D.primary === 'landline';
const primaryHref = primaryIsLandline ? PRACTICE.landlineHref : ROUTES.booking[locale];
const primaryLabel = primaryIsLandline ? D.primaryLabel[locale] : D.primary[locale];
// Secondary action: 'phone' | 'contact' | 'booking'.
const secondaryHref =
  D.secondary === 'phone' ? PRACTICE.phoneHref :
  D.secondary === 'booking' ? ROUTES.booking[locale] : ROUTES.contact[locale];
const SecondaryIcon = D.secondary === 'phone';
---
{inSection ? (
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>{D.title[locale]}</h2>
        <p>{D.text[locale]}</p>
        <div class="cta-banner-buttons">
          <a href={primaryHref} class="btn btn-secondary btn-lg">{primaryIsLandline && <Icon name="phone" size={18} />} {primaryLabel}</a>
          <a href={secondaryHref} class="btn btn-outline btn-lg cta-phone-fallback">
            {SecondaryIcon && <Icon name="phone" size={18} />} {D.secondaryLabel[locale]}
          </a>
        </div>
        {D.footnote && <p class="cta-banner-foot"><Icon name="map-pin" size={14} /> {D.footnote[locale]}</p>}
      </div>
    </div>
  </section>
) : (
  <div class="cta-banner" style="margin-bottom: var(--space-16);">
    <h2>{D.title[locale]}</h2>
    <p>{D.text[locale]}</p>
    <div class="cta-banner-buttons">
      <a href={primaryHref} class="btn btn-secondary btn-lg">{primaryIsLandline && <Icon name="phone" size={18} />} {primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-outline btn-lg cta-phone-fallback">
        {SecondaryIcon && <Icon name="phone" size={18} />} {D.secondaryLabel[locale]}
      </a>
    </div>
    {D.footnote && <p class="cta-banner-foot"><Icon name="map-pin" size={14} /> {D.footnote[locale]}</p>}
  </div>
)}
