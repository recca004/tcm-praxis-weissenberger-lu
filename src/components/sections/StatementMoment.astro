---
// The dealt moment: one quiet serif statement between hairlines.
import { STATEMENT } from '../../data/home.js';
const { locale } = Astro.props;
---
<section class="statement" aria-label="statement">
  <div class="container container-narrow">
    <p class="statement-text">{STATEMENT.text[locale]}</p>
  </div>
</section>
