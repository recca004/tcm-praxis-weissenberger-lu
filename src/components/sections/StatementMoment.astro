---
// The dealt moment: one quiet serif statement between hairlines with word-highlight.
import { STATEMENT } from '../../data/home.js';
const { locale } = Astro.props;
---
<section class="section statement" id="statement" data-moment="word-highlight" aria-label="statement">
  <div class="container container-narrow">
    <p class="statement-text mo-wh__text">{STATEMENT.text[locale]}</p>
  </div>
</section>
